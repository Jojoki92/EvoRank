{
  "appVersion": "9.0.0",
  "runtime": "Browser / PWA, kein Framework-Runtime-Download",
  "externalRuntimeDependencies": [
    {
      "name": "tesseract.js",
      "version": "5.1.1",
      "url": "https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js",
      "purpose": "optionale OCR-Erkennung beim Screenshot-Workout-Import",
      "loadedOnlyWhenNeeded": true
    }
  ],
  "serverlessDependencies": [
    {
      "name": "node:dns/promises",
      "type": "Node built-in"
    },
    {
      "name": "node:net",
      "type": "Node built-in"
    }
  ],
  "notes": [
    "Es gibt keine npm-Laufzeitabhängigkeiten im veröffentlichten Haupt-Frontend.",
    "OCR ist optional und wird erst beim Screenshot-Import geladen.",
    "Vor jedem Release wird security-audit.mjs ausgeführt."
  ]
}
